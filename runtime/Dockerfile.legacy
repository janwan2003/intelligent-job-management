FROM pytorch/pytorch:1.5.1-cuda10.1-cudnn7-runtime

WORKDIR /app

# torchvision 0.6.1 pairs with torch 1.5.1; numpy is already in the base image.
RUN pip install --no-cache-dir --progress-bar off torchvision==0.6.1

ARG SCRIPT=lstm_small.py
COPY base.py .
COPY ${SCRIPT} ./train.py

RUN mkdir -p /checkpoints /runs && chmod 0777 /checkpoints /runs

CMD ["python", "-u", "train.py"]
