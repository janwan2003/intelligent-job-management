@startuml CurrentPrototype
title Current Prototype Architecture (distributed)

' ───────────────────────────── global style ─────────────────────────────
' stereotypes drive per-element colour only — never render their labels
hide stereotype
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam TitleFontSize 20
skinparam TitleFontColor #1F2933

skinparam ArrowColor #6B7A8D
skinparam ArrowFontColor #4A5563
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2

skinparam actor {
    BackgroundColor #E8EDF3
    BorderColor #44515E
    FontColor #1F2933
}

' ── package (zone) colours ──
skinparam package {
    FontColor #1F2933
    FontSize 14
    BorderThickness 1.5
    BackgroundColor<<user>>   #F4F7FF
    BorderColor<<user>>       #3B5BDB
    BackgroundColor<<legacy>> #FFF8F0
    BorderColor<<legacy>>     #D9822B
    BackgroundColor<<modern>> #F0FBF6
    BorderColor<<modern>>     #2F9E68
}

' ── component (box) colours ──
skinparam rectangle {
    FontColor #1F2933
    BorderThickness 1.3
    BackgroundColor<<ui>>     #DCE6FF
    BorderColor<<ui>>         #3B5BDB
    BackgroundColor<<core>>   #C7D6FF
    BorderColor<<core>>       #2A44B8
    BackgroundColor<<opt>>    #ECE3FF
    BorderColor<<opt>>        #7C5CD6
    BackgroundColor<<wlegacy>> #FFE9CC
    BorderColor<<wlegacy>>    #D9822B
    BackgroundColor<<wmodern>> #CFF0DE
    BorderColor<<wmodern>>    #2F9E68
}

skinparam database {
    BackgroundColor #EDE3FF
    BorderColor #6B46C1
    BorderThickness 1.5
    FontColor #1F2933
}

skinparam cloud {
    BackgroundColor #EEF1F5
    BorderColor #8593A3
    BorderThickness 1.4
    FontColor #44515E
}

skinparam folder {
    BackgroundColor #F2F4F7
    BorderColor #8593A3
    FontColor #44515E
}

skinparam note {
    BackgroundColor #FFFDF2
    BorderColor #D9C97A
    FontColor #4A4530
    FontSize 11
}

' ───────────────────────────── nodes ─────────────────────────────
actor User

package "User machine" <<user>> {
    rectangle "**React SPA**\nVite dev / nginx" as UI <<ui>>
    rectangle "**REST API** (FastAPI)\n+ ProfilingScheduler\n+ JobDispatcher\n+ NodeSlots (per-node semaphores)\n+ Optimizer client" as API <<core>>
    rectangle "**GPUspb Optimizer**\nHTTP, optional" as OPT <<opt>>
}

cloud "SSH tunnels\nports 5432, 800x" as SSH

package "Remote GPU node A\nmatemagician — legacy CUDA 10.1" <<legacy>> {
    rectangle "**Worker** (FastAPI HTTP)" as WorkerA <<wlegacy>>
    rectangle "Docker containers\n:legacy image" as DockerA <<wlegacy>>
    folder "Checkpoints / Run logs\nshared rclone-SFTP mount" as FSA
}

package "Remote GPU node B\npolimi-gpu — A40" <<modern>> {
    rectangle "**Worker** (FastAPI HTTP)" as WorkerB <<wmodern>>
    rectangle "Docker containers\n:latest image" as DockerB <<wmodern>>
    folder "Checkpoints / Run logs\nshared rclone-SFTP mount" as FSB
}

database "PostgreSQL\non a GPU node" as DB

' ───────────────────────────── interactions ─────────────────────────────
User --> UI
UI --> API : HTTP (CORS-gated)

API --> OPT : POST /optimizer/v5\n(jobs + currentScheduling)
API --> SSH
SSH --> WorkerA : POST /jobs/{id}/run\nPOST /jobs/{id}/stop?reason=user|auto
SSH --> WorkerB : POST /jobs/{id}/run\nPOST /jobs/{id}/stop?reason=user|auto
SSH --> DB

WorkerA --> DockerA : run / kill\n(per-job container)
WorkerB --> DockerB : run / kill
DockerA --> FSA : save/load
DockerB --> FSB : save/load

WorkerA --> DB : status / progress\nNOTIFY ijm_schedule\nNOTIFY ijm_slot_freed
WorkerB --> DB : status / progress\nNOTIFY ijm_schedule\nNOTIFY ijm_slot_freed

note right of API
    • Job CRUD, stop/resume, log proxy
    • Profile-always policy (1 cfg / instance)
    • Two-tier scheduling:
        Phase 1a — sweep stale claims, reset stuck QUEUED
        Phase 1b — optimizer ⇒ assignments + preempts
        Phase 1c — proactive profile-preempt
        Greedy fallback for un-optimized jobs
    • LISTEN ijm_schedule (wake scheduler)
    • LISTEN ijm_slot_freed (release semaphores)
    • Periodic drift watcher (5 min)
end note

note right of WorkerA
    • Atomic Phase 1 claim of QUEUED row
    • Dispatch + stream logs in subprocess
    • Stale-stop guard (assigned_node ≠ self)
    • Pre-flipped PREEMPTED handling
    • Zombie release on kill failure
    • Cross-version stderr filter
end note

note bottom of FSA
    Checkpoints stored in legacy
    pre-1.6 torch format so a job can
    resume across nodes regardless of
    the running torch version.
end note

@enduml
