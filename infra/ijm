#!/usr/bin/env bash
# IJM cluster orchestrator. One command per lifecycle action.
#
#   bash infra/ijm up        # tunnel + dockerised API/optimizer/frontend
#   bash infra/ijm down      # stop local docker + close tunnel
#   bash infra/ijm deploy    # push worker code + restart both remote workers
#   bash infra/ijm status    # health of tunnel, workers, API, postgres
#   bash infra/ijm logs      # tail docker + remote worker logs
#
# Day-to-day:  `ijm up` once per session, `ijm deploy` when worker code changes.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INFRA="$REPO_ROOT/infra"
TUNNEL_HOST="${TUNNEL_HOST:-polimi}"
COMPOSE_FILE="$INFRA/docker-compose.tunnel.yml"
TUNNEL_PIDFILE="/tmp/ijm-tunnel.pid"
# Remote deploy identity — the single source of truth for the account whose
# name prefixes the containers and deploy path on the shared host.  Everything
# below (REMOTE_DIR, container names) derives from it; override with a single
# env var for a different account:  IJM_REMOTE_USER=alice bash infra/ijm deploy
IJM_REMOTE_USER="${IJM_REMOTE_USER:-wangrat}"
REMOTE_DIR="${REMOTE_DIR:-/home/$IJM_REMOTE_USER/ijm}"
PG_CONTAINER="${IJM_REMOTE_USER}-ijm-postgres"

c_red()   { printf "\033[1;31m%s\033[0m\n" "$*"; }
c_green() { printf "\033[1;32m%s\033[0m\n" "$*"; }
c_blue()  { printf "\033[1;36m%s\033[0m\n" "$*"; }

port_listening() {
    # Portable across Linux + macOS (no `ss` on macOS): probe the port with
    # bash's built-in /dev/tcp instead of parsing socket tables.
    (: < "/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

tunnel_up() {
    if port_listening 5433 && port_listening 8001 && port_listening 8002; then
        return 0
    fi
    return 1
}

ensure_tunnel() {
    if tunnel_up; then
        c_green "  ✓ tunnel already open (5433/8001/8002)"
        return 0
    fi
    c_blue "  → opening tunnel via $TUNNEL_HOST"
    ssh -fN \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=3 \
        -L 0.0.0.0:5433:localhost:5433 \
        -L 0.0.0.0:8001:localhost:8001 \
        -L 0.0.0.0:8002:10.79.23.173:8001 \
        "$TUNNEL_HOST"
    # Record the pid for clean teardown.
    pgrep -f "ssh -fN.*-L 0.0.0.0:5433:localhost:5433.*$TUNNEL_HOST" | head -1 > "$TUNNEL_PIDFILE" || true
    sleep 1
    if tunnel_up; then
        c_green "  ✓ tunnel open"
    else
        c_red "  ✗ tunnel did not come up — check ssh access to $TUNNEL_HOST"
        exit 1
    fi
}

worker_ok() {
    curl -sf --max-time 3 "http://localhost:$1/health" >/dev/null 2>&1
}

check_workers() {
    local fail=0
    worker_ok 8001 && c_green "  ✓ matemagician (8001)" || { c_red "  ✗ matemagician unreachable"; fail=1; }
    worker_ok 8002 && c_green "  ✓ polimi-gpu (8002)" || { c_red "  ✗ polimi-gpu unreachable"; fail=1; }
    return $fail
}

cmd_up() {
    c_blue "[1/3] Tunnel"
    ensure_tunnel

    c_blue "[2/3] Workers"
    if ! check_workers; then
        c_red "  one or both workers down — run: bash infra/ijm deploy"
    fi

    c_blue "[3/3] Local stack (API + optimizer + frontend)"
    HOST_PROJECT_ROOT="$REMOTE_DIR" docker compose -f "$COMPOSE_FILE" up -d
    # Up to ~60 s: if the API crash-looped while the tunnel was down, the
    # in-flight startup attempt spends 30 s timing out on the DB pool
    # before it exits and the restart policy brings up one that connects.
    for i in $(seq 1 60); do
        curl -sf -m 2 http://localhost:8000/health >/dev/null 2>&1 && break
        sleep 1
    done
    if curl -sf -m 5 http://localhost:8000/health >/dev/null; then
        c_green "  ✓ API: http://localhost:8000"
        c_green "  ✓ Frontend: http://localhost:5173"
        curl -s http://localhost:8000/admin/slots 2>/dev/null | \
            python3 -c "import json,sys;d=json.load(sys.stdin);[print(f'    {n}: {v[\"total\"]-v[\"used_db\"]}/{v[\"total\"]} GPUs available') for n,v in d['per_node'].items()]" 2>/dev/null || true
    else
        c_red "  ✗ API not responding — docker logs ijm-api"
        exit 1
    fi
}

cmd_down() {
    c_blue "[1/2] Local stack"
    HOST_PROJECT_ROOT="$REMOTE_DIR" docker compose -f "$COMPOSE_FILE" down 2>&1 | tail -5
    c_blue "[2/2] Tunnel"
    if [ -f "$TUNNEL_PIDFILE" ]; then
        local pid; pid=$(cat "$TUNNEL_PIDFILE")
        kill "$pid" 2>/dev/null && c_green "  ✓ tunnel closed (pid $pid)" || true
        rm -f "$TUNNEL_PIDFILE"
    else
        pkill -f "ssh -fN.*-L 0.0.0.0:5433.*$TUNNEL_HOST" 2>/dev/null && c_green "  ✓ tunnel closed" || c_green "  ✓ no tunnel found"
    fi
    if [[ "${1:-}" == "--workers" ]]; then
        c_blue "[3/2] Remote workers"
        ssh "$TUNNEL_HOST" "cd $REMOTE_DIR && docker-compose down" 2>&1 | tail -3 || true
        ssh polimi-gpu "ss -tlnpH 2>/dev/null | awk '\$4 ~ /:8001\$/ {print}' | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 | xargs -r kill" 2>/dev/null || true
        c_green "  ✓ remote workers stopped"
    else
        c_green "Remote workers left running. To stop them too: bash infra/ijm down --workers"
    fi
}

cmd_deploy() {
    # Open ONE SSH control master for matemagician (TUNNEL_HOST=polimi) for
    # the duration of this command — every subsequent `ssh polimi ...` will
    # reuse this connection.  Without this, the many ssh calls in deploy.sh,
    # the schema step, and worker recreate trip fail2ban on matemagician.
    local cm="/tmp/ijm-deploy-cm-$$"
    ssh -fNM -S "$cm" -o ControlPersist=120 "$TUNNEL_HOST"
    trap "ssh -S '$cm' -O exit '$TUNNEL_HOST' 2>/dev/null; rm -f '$cm'" RETURN

    local ssh_reuse=(ssh -S "$cm" "$TUNNEL_HOST")

    c_blue "[1/3] matemagician (postgres + worker container)"
    # matemagician topology (hardcoded here since ijm already knows the
    # cluster shape via TUNNEL_HOST=polimi):
    #   - NODE_ID=matemagician     (API's nodes_config calls it that; the
    #     worker's atomic-claim filter compares assigned_node=NODE_ID)
    #   - WORKER_GPU_MODE=runtime  (nvidia default runtime; matemagician
    #     is NOT rootless docker)
    #   - IMAGE_TAG_OVERRIDE=legacy (CUDA-10.1 driver can't run :latest
    #     which is CUDA-12.4)
    #   - NODE_TOTAL_GPUS=2        (2× QuadroP600)
    local mate_env="NODE_ID=matemagician WORKER_GPU_MODE=runtime IMAGE_TAG_OVERRIDE=legacy NODE_TOTAL_GPUS=2"
    env $mate_env bash "$INFRA/deploy.sh"
    # deploy.sh runs `up --build -d` but docker-compose v1 keeps an existing
    # container if no diff is detected; force-recreate to pick up rsynced
    # code.  Must also re-pass all env here — the compose file uses
    # ${NODE_ID} / ${WORKER_GPU_MODE} / ${IMAGE_TAG_OVERRIDE} /
    # ${NODE_TOTAL_GPUS} which all resolve to empty without it.
    "${ssh_reuse[@]}" "cd $REMOTE_DIR && $mate_env IJM_REMOTE_USER=$IJM_REMOTE_USER HOST_PROJECT_ROOT=$REMOTE_DIR docker-compose up --build -d --force-recreate --no-deps worker" 2>&1 | tail -5

    c_blue "[2/3] schema (apply to remote postgres if missing)"
    # Wait for postgres to be ready (just-started compose returns -d before
    # the healthcheck passes).
    for i in $(seq 1 30); do
        "${ssh_reuse[@]}" "docker exec $PG_CONTAINER pg_isready -U postgres -q" 2>/dev/null && break
        sleep 1
    done
    # Polimi-gpu worker queries jobs during reconcile() on startup; if
    # postgres is fresh (no API has run yet) this fails.  Apply schema
    # idempotently via the matemagician postgres container.
    if "${ssh_reuse[@]}" "docker exec $PG_CONTAINER psql -U postgres -d ijm -c '\\dt' 2>/dev/null | grep -q jobs"; then
        c_green "  ✓ schema already present"
    else
        local err
        err=$("${ssh_reuse[@]}" "docker exec -i $PG_CONTAINER psql -U postgres -d ijm -q -v ON_ERROR_STOP=1" < "$REPO_ROOT/backend/schema.sql" 2>&1) \
            && c_green "  ✓ schema applied" \
            || { c_red "  ✗ schema apply failed:"; echo "$err" | head -5; exit 1; }
    fi

    c_blue "[3/3] polimi-gpu (native uvicorn)"
    bash "$INFRA/deploy_native.sh" polimi-gpu
    c_green "==> Deploy complete. Run: bash infra/ijm status"
}

cmd_status() {
    c_blue "Tunnel"
    tunnel_up && c_green "  ✓ 5433/8001/8002 listening" || c_red "  ✗ tunnel ports not all listening"
    c_blue "Workers"
    check_workers || true
    c_blue "Local stack"
    for svc in ijm-api ijm-optimizer ijm-frontend; do
        if docker ps --format '{{.Names}}' | grep -q "^$svc\$"; then
            c_green "  ✓ $svc"
        else
            c_red "  ✗ $svc not running"
        fi
    done
    c_blue "API"
    if curl -sf -m 3 http://localhost:8000/health >/dev/null; then
        c_green "  ✓ /health"
        curl -s http://localhost:8000/admin/slots 2>/dev/null | \
            python3 -c "import json,sys;d=json.load(sys.stdin);[print(f'    {n}: {v[\"total\"]-v[\"used_db\"]}/{v[\"total\"]} free, drift={v[\"drift\"]}') for n,v in d['per_node'].items()]" 2>/dev/null || true
    else
        c_red "  ✗ API not responding"
    fi
}

cmd_logs() {
    docker logs -f --tail 50 ijm-api &
    local apipid=$!
    trap "kill $apipid 2>/dev/null" EXIT
    wait $apipid
}

case "${1:-}" in
    up)     shift; cmd_up "$@" ;;
    down)   shift; cmd_down "$@" ;;
    deploy) shift; cmd_deploy "$@" ;;
    status) shift; cmd_status "$@" ;;
    logs)   shift; cmd_logs "$@" ;;
    ""|help|-h|--help)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        c_red "unknown subcommand: $1"
        echo "Try: bash infra/ijm help"
        exit 1
        ;;
esac
